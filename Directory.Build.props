<Project>
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <NoWarn>$(NoWarn);CA1848;CA1873</NoWarn>
    <RootNamespace>$(MSBuildProjectName)</RootNamespace>
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <!-- Without this, tests/Directory.Build.props would make the test projects use their own tests/artifacts. -->
    <ArtifactsPath>$(MSBuildThisFileDirectory)artifacts</ArtifactsPath>
    <SatelliteResourceLanguages>en;zh-Hans</SatelliteResourceLanguages>
    <DebugType>embedded</DebugType>
    <!-- MinVer: release tags look like v1.2.3. -->
    <MinVerTagPrefix>v</MinVerTagPrefix>
  </PropertyGroup>

  <Import Project="Directory.Build.user" Condition="Exists('Directory.Build.user')" />
</Project>
