<Project>
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <NoWarn>$(NoWarn);CA1848;CA1873</NoWarn>
    <RootNamespace>$(MSBuildProjectName)</RootNamespace>
    <UseArtifactsOutputPath>true</UseArtifactsOutputPath>
    <SatelliteResourceLanguages>en;zh-Hans</SatelliteResourceLanguages>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <Import Project="Directory.Build.user" Condition="Exists('Directory.Build.user')" />
</Project>
