<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ai="using:Swiftlet.Desktop.ViewModels.Ai"
        xmlns:loc="using:Swiftlet.Desktop.Localization"
        xmlns:controls="using:Swiftlet.Desktop.Controls"
        x:Class="Swiftlet.Desktop.Views.ClassifyWindow"
        Icon="avares://Swiftlet/Assets/swiftlet.ico"
        x:DataType="ai:ClassifyViewModel"
        Title="{loc:Loc Classify_Title}" Width="560" Height="560" MinWidth="440" MinHeight="360"
        WindowStartupLocation="CenterOwner">
  <controls:DialogFrame>
    <DockPanel Margin="16">
      <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,12">
        <TextBlock Classes="secondary" Text="{loc:Loc Classify_Hint}" TextWrapping="Wrap" />
        <TextBlock Classes="caption" Text="{Binding LimitText}" TextWrapping="Wrap"
                   IsVisible="{Binding LimitText, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </StackPanel>
      <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="0,12,0,0" ColumnSpacing="8">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Classes="caption" Text="{Binding ProgressText}" VerticalAlignment="Center" />
          <ProgressBar Width="80" MinWidth="80" IsIndeterminate="True" IsVisible="{Binding IsRunning}" />
          <Button Content="{loc:Loc Ai_Stop}" Command="{Binding StopCommand}" IsVisible="{Binding IsRunning}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button Content="{loc:Loc Common_Close}" Command="{Binding CloseCommand}" IsCancel="True" />
          <Button Classes="accent" Content="{loc:Loc Classify_Apply}" Command="{Binding ApplyCommand}" MinWidth="88"
                  HorizontalContentAlignment="Center" />
        </StackPanel>
      </Grid>
      <TextBlock DockPanel.Dock="Bottom" Classes="error" Text="{Binding ErrorText}" TextWrapping="Wrap" Margin="0,8,0,0"
                 IsVisible="{Binding ErrorText, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <Border Classes="card" Padding="0">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding Items}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="ai:ClassifyItemViewModel">
                <Border Padding="12,8" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Brush.Border}">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding Subject}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="caption" Text="{Binding Sender}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="caption" Text="{Binding StatusText}" TextWrapping="Wrap"
                               IsVisible="{Binding StatusText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <ItemsControl ItemsSource="{Binding Suggestions}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="ai:SuggestionViewModel">
                          <CheckBox Margin="0,0,16,0" IsChecked="{Binding IsChecked}">
                            <!-- A text block keeps underscores of label names, which plain content reads as access keys. -->
                            <TextBlock Text="{Binding Text}" />
                          </CheckBox>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Border>
    </DockPanel>
  </controls:DialogFrame>
</Window>
