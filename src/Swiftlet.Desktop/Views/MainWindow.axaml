<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:main="using:Swiftlet.Desktop.ViewModels.Main"
        xmlns:views="using:Swiftlet.Desktop.Views"
        xmlns:loc="using:Swiftlet.Desktop.Localization"
        xmlns:ctl="using:Swiftlet.Desktop.Controls"
        xmlns:conv="using:Swiftlet.Desktop.Converters"
        x:Class="Swiftlet.Desktop.Views.MainWindow"
        Icon="avares://Swiftlet.Desktop/Assets/swiftlet.ico"
        x:DataType="main:MainWindowViewModel"
        Title="Swiftlet" Width="1200" Height="760" MinWidth="800" MinHeight="480">
  <Window.Styles>
    <Style Selector="TextBlock.unread">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <!-- Shown only on rows with unread mail, whose names are also set in the unread weight. -->
    <Style Selector="TextBlock.caption.badge">
      <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TreeViewItem">
      <Setter Property="IsExpanded" Value="True" />
    </Style>
    <Style Selector="Grid.node">
      <Setter Property="ColumnSpacing" Value="8" />
    </Style>
    <Style Selector="Grid.node > PathIcon">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    </Style>
    <Style Selector="Grid.node.section">
      <Setter Property="Margin" Value="0,12,0,0" />
    </Style>
    <Style Selector="StackPanel.empty">
      <Setter Property="Spacing" Value="12" />
      <Setter Property="Margin" Value="24" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="StackPanel.empty > PathIcon">
      <Setter Property="Width" Value="48" />
      <Setter Property="Height" Value="48" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    </Style>
    <Style Selector="StackPanel.empty > TextBlock">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="TextAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.card.filters">
      <Setter Property="Margin" Value="8,0,8,8" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Border.filters TextBlock.caption">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.filters CalendarDatePicker">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <!-- Year first reads the same in every language, unlike the culture's day and month order. -->
      <Setter Property="SelectedDateFormat" Value="Custom" />
      <Setter Property="CustomDateFormatString" Value="yyyy-MM-dd" />
    </Style>
    <Style Selector="GridSplitter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
  </Window.Styles>

  <DockPanel>
    <Border DockPanel.Dock="Bottom" Padding="12,4" BorderThickness="0,1,0,0" Background="{DynamicResource Brush.SidebarBg}"
            BorderBrush="{DynamicResource Brush.Border}">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Classes="caption" Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        <ProgressBar Grid.Column="1" Width="120" IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
      </Grid>
    </Border>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="220" MinWidth="180" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="2*" MinWidth="260" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="3*" MinWidth="300" />
      </Grid.ColumnDefinitions>

      <Border x:Name="Sidebar" Grid.Column="0" Background="{DynamicResource Brush.SidebarBg}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Margin="12,12,12,8" Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Data="{StaticResource Icon.Logo}" Width="24" Height="20" Foreground="{DynamicResource Brush.Accent}" />
              <TextBlock Classes="section" Text="Swiftlet" VerticalAlignment="Center" />
            </StackPanel>
            <Button Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="12,8"
                    Command="{Binding ComposeCommand}" AutomationProperties.Name="{loc:Loc Toolbar_Compose}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{StaticResource Icon.Compose}" />
                <TextBlock Text="{loc:Loc Toolbar_Compose}" />
              </StackPanel>
            </Button>
          </StackPanel>

          <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="8">
            <Button Classes="icon" HorizontalAlignment="Left" Command="{Binding AddAccountCommand}"
                    ToolTip.Tip="{loc:Loc Toolbar_AddAccount}" AutomationProperties.Name="{loc:Loc Toolbar_AddAccount}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{StaticResource Icon.AddAccount}" />
                <TextBlock Text="{loc:Loc Toolbar_AddAccount}" />
              </StackPanel>
            </Button>
            <Button Grid.Column="1" Classes="icon" Command="{Binding OpenSettingsCommand}"
                    ToolTip.Tip="{loc:Loc Toolbar_Settings}" AutomationProperties.Name="{loc:Loc Toolbar_Settings}">
              <PathIcon Data="{StaticResource Icon.Settings}" />
            </Button>
          </Grid>

          <!-- The right padding keeps long rows clear of the scroll bar, which floats over the content. -->
          <TreeView ItemsSource="{Binding TreeRoots}" SelectedItem="{Binding SelectedNode}" Margin="4,0" Padding="0,0,12,0"
                    Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <TreeView.DataTemplates>
              <TreeDataTemplate DataType="main:AccountNodeViewModel" ItemsSource="{Binding Folders}">
                <Grid Classes="node" ColumnDefinitions="Auto,*" Background="Transparent" ToolTip.Tip="{Binding Account.EmailAddress}">
                  <Grid.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="{loc:Loc Menu_Account_Settings}"
                                Command="{Binding $parent[TreeView].((main:MainWindowViewModel)DataContext).EditAccountCommand}"
                                CommandParameter="{Binding}" />
                      <MenuItem Header="{loc:Loc Menu_Account_Delete}"
                                Command="{Binding $parent[TreeView].((main:MainWindowViewModel)DataContext).DeleteAccountCommand}"
                                CommandParameter="{Binding}" />
                      <MenuItem Header="{loc:Loc Menu_Account_Reauthenticate}" IsVisible="{Binding CanReauthenticate}"
                                Command="{Binding $parent[TreeView].((main:MainWindowViewModel)DataContext).ReauthenticateAccountCommand}"
                                CommandParameter="{Binding}" />
                    </ContextMenu>
                  </Grid.ContextMenu>
                  <Border Width="22" Height="22" CornerRadius="11" Background="{Binding AvatarBrush}">
                    <TextBlock Text="{Binding Initial}" Foreground="White" FontSize="12" HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                  </Border>
                  <DockPanel Grid.Column="1" HorizontalAlignment="Left">
                    <TextBlock DockPanel.Dock="Right" Classes="caption badge" Text="{Binding UnreadText}" IsVisible="{Binding HasUnread}"
                               Margin="8,0,0,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding DisplayName}" Classes.unread="{Binding HasUnread}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                  </DockPanel>
                </Grid>
              </TreeDataTemplate>
              <DataTemplate DataType="main:UnifiedInboxNodeViewModel">
                <Grid Classes="node" ColumnDefinitions="Auto,*">
                  <PathIcon Data="{StaticResource Icon.AllInboxes}" />
                  <!-- The badge is measured first, so it follows the name and stays visible when the name is trimmed. -->
                  <DockPanel Grid.Column="1" HorizontalAlignment="Left">
                    <TextBlock DockPanel.Dock="Right" Classes="caption badge" Text="{Binding UnreadText}" IsVisible="{Binding HasUnread}"
                               Margin="8,0,0,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Name}" Classes.unread="{Binding HasUnread}" TextTrimming="CharacterEllipsis" />
                  </DockPanel>
                </Grid>
              </DataTemplate>
              <DataTemplate DataType="main:LabelNodeViewModel">
                <Grid Classes="node" Classes.section="{Binding StartsSection}" ColumnDefinitions="Auto,*">
                  <Border Width="10" Height="10" Margin="3,0" CornerRadius="5" Background="{Binding Brush}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                </Grid>
              </DataTemplate>
              <DataTemplate DataType="main:FolderNodeViewModel">
                <Grid Classes="node" ColumnDefinitions="Auto,*" Background="Transparent">
                  <Grid.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="{loc:Loc Menu_Folder_Empty}" IsEnabled="{Binding CanEmpty}"
                                Command="{Binding $parent[TreeView].((main:MainWindowViewModel)DataContext).EmptyFolderCommand}"
                                CommandParameter="{Binding}" />
                    </ContextMenu>
                  </Grid.ContextMenu>
                  <PathIcon Data="{Binding IconKey, Converter={x:Static conv:IconKeyConverter.Instance}}" />
                  <DockPanel Grid.Column="1" HorizontalAlignment="Left">
                    <TextBlock DockPanel.Dock="Right" Classes="caption badge" Text="{Binding UnreadText}" IsVisible="{Binding HasUnread}"
                               Margin="8,0,0,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Name}" Classes.unread="{Binding HasUnread}" TextTrimming="CharacterEllipsis" />
                  </DockPanel>
                </Grid>
              </DataTemplate>
            </TreeView.DataTemplates>
          </TreeView>
        </DockPanel>
      </Border>

      <GridSplitter Grid.Column="1" Width="4" />

      <Border x:Name="MessagePane" Grid.Column="2" Background="{DynamicResource Brush.Surface}" BorderThickness="1,0"
              BorderBrush="{DynamicResource Brush.Border}" IsVisible="{Binding !IsAccountPageShown}">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4" Margin="8">
            <TextBox PlaceholderText="{loc:Loc Search_Placeholder}" Text="{Binding SearchText}">
              <TextBox.InnerLeftContent>
                <PathIcon Data="{StaticResource Icon.Search}" Width="14" Height="14" Margin="8,0,0,0"
                          Foreground="{DynamicResource Brush.TextSecondary}" />
              </TextBox.InnerLeftContent>
              <TextBox.KeyBindings>
                <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}" />
              </TextBox.KeyBindings>
            </TextBox>
            <ToggleButton Grid.Column="1" x:Name="FilterToggle" Classes="icon" IsChecked="{Binding Filter.IsExpanded}"
                          ToolTip.Tip="{loc:Loc Search_Filters}" AutomationProperties.Name="{loc:Loc Search_Filters}">
              <Panel Width="18" Height="18">
                <PathIcon Data="{StaticResource Icon.Filter}" Width="18" Height="18" />
                <!-- Points out conditions that apply, also while they are hidden. -->
                <Border x:Name="FilterIndicator" Width="8" Height="8" CornerRadius="4" Margin="0,-2,-2,0" HorizontalAlignment="Right"
                        VerticalAlignment="Top" Background="{DynamicResource Brush.Accent}" IsVisible="{Binding Filter.HasActiveFilters}" />
              </Panel>
            </ToggleButton>
            <Button Grid.Column="2" Classes="icon" Command="{Binding SyncCommand}"
                    ToolTip.Tip="{loc:Loc Toolbar_Sync}" AutomationProperties.Name="{loc:Loc Toolbar_Sync}">
              <PathIcon Data="{StaticResource Icon.Sync}" />
            </Button>
          </Grid>

          <!-- The height is limited so the list stays usable in a low window; the conditions scroll, the buttons stay. -->
          <Border x:Name="SearchFilters" DockPanel.Dock="Top" Classes="card filters" IsVisible="{Binding Filter.IsExpanded}">
            <DockPanel MaxHeight="360">
              <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="12,8,12,12">
                <Button Content="{loc:Loc Search_Clear}" Command="{Binding ClearSearchFiltersCommand}" />
                <Button Classes="accent" Content="{loc:Loc Search_Run}" Command="{Binding SearchCommand}" />
              </StackPanel>
              <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <!-- The wider right margin keeps the scroll bar off the inputs. -->
                <StackPanel Spacing="4" Margin="12,12,16,0">
                  <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="4">
                    <TextBlock Classes="caption" Text="{loc:Loc Search_From}" />
                    <TextBox Grid.Column="1" Text="{Binding Filter.From}" PlaceholderText="{loc:Loc Search_FromPlaceholder}"
                             AutomationProperties.Name="{loc:Loc Search_From}">
                      <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}" />
                      </TextBox.KeyBindings>
                    </TextBox>
                    <TextBlock Grid.Row="1" Classes="caption" Text="{loc:Loc Search_To}" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Filter.To}" PlaceholderText="{loc:Loc Search_ToPlaceholder}"
                             AutomationProperties.Name="{loc:Loc Search_To}">
                      <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}" />
                      </TextBox.KeyBindings>
                    </TextBox>
                    <TextBlock Grid.Row="2" Classes="caption" Text="{loc:Loc Search_Subject}" />
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Filter.Subject}" AutomationProperties.Name="{loc:Loc Search_Subject}">
                      <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}" />
                      </TextBox.KeyBindings>
                    </TextBox>
                    <TextBlock Grid.Row="3" Classes="caption" Text="{loc:Loc Search_DateFrom}" />
                    <CalendarDatePicker Grid.Row="3" Grid.Column="1"
                                        SelectedDate="{Binding Filter.DateFrom, Mode=TwoWay, Converter={x:Static conv:DateOnlyConverter.Instance}}"
                                        AutomationProperties.Name="{loc:Loc Search_DateFrom}" />
                    <TextBlock Grid.Row="4" Classes="caption" Text="{loc:Loc Search_DateTo}" />
                    <CalendarDatePicker Grid.Row="4" Grid.Column="1"
                                        SelectedDate="{Binding Filter.DateTo, Mode=TwoWay, Converter={x:Static conv:DateOnlyConverter.Instance}}"
                                        AutomationProperties.Name="{loc:Loc Search_DateTo}" />
                    <TextBlock Grid.Row="5" Classes="caption" Text="{loc:Loc Search_Scope}" />
                    <ComboBox Grid.Row="5" Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="{Binding Filter.ScopeIndex}"
                              AutomationProperties.Name="{loc:Loc Search_Scope}">
                      <!-- In the order of the SearchScope values. -->
                      <ComboBoxItem Content="{loc:Loc Search_ScopeAccount}" IsEnabled="{Binding Filter.CanSearchAccount}" />
                      <ComboBoxItem Content="{loc:Loc Search_ScopeFolder}" IsEnabled="{Binding Filter.CanSearchFolder}" />
                      <ComboBoxItem Content="{loc:Loc Search_ScopeAll}" />
                    </ComboBox>
                  </Grid>
                  <TextBlock Classes="error" FontSize="12" Text="{loc:Loc Search_InvalidDateRange}" TextWrapping="Wrap"
                             IsVisible="{Binding Filter.HasInvalidDateRange}" />
                  <WrapPanel>
                    <CheckBox Content="{loc:Loc Search_HasAttachments}" IsChecked="{Binding Filter.HasAttachments}" Margin="0,0,16,0" />
                    <CheckBox Content="{loc:Loc Search_UnreadOnly}" IsChecked="{Binding Filter.UnreadOnly}" Margin="0,0,16,0" />
                    <CheckBox Content="{loc:Loc Search_FlaggedOnly}" IsChecked="{Binding Filter.FlaggedOnly}" />
                  </WrapPanel>
                </StackPanel>
              </ScrollViewer>
            </DockPanel>
          </Border>

          <Grid>
            <ListBox Classes="messages" Background="Transparent" ItemsSource="{Binding Messages}" SelectedItem="{Binding SelectedMessage}"
                     SelectionMode="Multiple" SelectedItems="{Binding SelectedMessages}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.ScrollChanged="OnMessageListScrollChanged">
              <ListBox.KeyBindings>
                <KeyBinding Gesture="Delete" Command="{Binding DeleteSelectedCommand}" />
              </ListBox.KeyBindings>
              <ListBox.ContextMenu>
                <ContextMenu Opening="OnMessageMenuOpening">
                  <MenuItem Header="{loc:Loc Toolbar_Archive}" Command="{Binding ArchiveSelectedCommand}" />
                  <MenuItem Header="{loc:Loc Toolbar_Delete}" Command="{Binding DeleteSelectedCommand}" />
                  <MenuItem Header="{loc:Loc Menu_Message_MoveTo}" ItemsSource="{Binding MoveTargets}" IsEnabled="{Binding CanMove}">
                    <MenuItem.ItemContainerTheme>
                      <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}"
                                    x:DataType="main:MoveTargetViewModel">
                        <Setter Property="Command" Value="{Binding Command}" />
                        <Setter Property="CommandParameter" Value="{Binding Folder}" />
                      </ControlTheme>
                    </MenuItem.ItemContainerTheme>
                    <MenuItem.ItemTemplate>
                      <!-- A text block keeps underscores of folder names, which a plain header reads as access keys. -->
                      <DataTemplate DataType="main:MoveTargetViewModel">
                        <TextBlock Text="{Binding Name}" />
                      </DataTemplate>
                    </MenuItem.ItemTemplate>
                  </MenuItem>
                </ContextMenu>
              </ListBox.ContextMenu>
              <ListBox.ItemTemplate>
                <DataTemplate DataType="main:MessageItemViewModel">
                  <Border Padding="8,8,12,8" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Brush.Border}">
                    <Grid ColumnDefinitions="16,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="2">
                      <Border Classes="unreadDot" Width="8" Height="8" CornerRadius="4" HorizontalAlignment="Left" VerticalAlignment="Center"
                              Background="{DynamicResource Brush.Accent}" IsVisible="{Binding IsUnread}" />
                      <TextBlock Grid.Column="1" Text="{Binding FromDisplay}" Classes.unread="{Binding IsUnread}"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="2" Classes="caption" Text="{Binding ListTimeText}" Margin="8,0,0,0" VerticalAlignment="Center" />
                      <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Subject}" Classes.unread="{Binding IsUnread}"
                                 TextTrimming="CharacterEllipsis" />
                      <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Spacing="4" Margin="8,0,0,0"
                                  HorizontalAlignment="Right">
                        <PathIcon Data="{StaticResource Icon.Attach}" Width="14" Height="14" IsVisible="{Binding HasAttachments}"
                                  Foreground="{DynamicResource Brush.TextSecondary}" />
                        <PathIcon Data="{StaticResource Icon.StarFilled}" Width="14" Height="14" IsVisible="{Binding IsFlagged}"
                                  Foreground="{DynamicResource Brush.Star}" />
                      </StackPanel>
                      <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Classes="caption" Text="{Binding Preview}"
                                 TextTrimming="CharacterEllipsis" />
                      <ItemsControl Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" ItemsSource="{Binding Labels}"
                                    IsVisible="{Binding HasLabels}" Margin="0,2,0,0">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <WrapPanel />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="main:LabelChipViewModel">
                            <Border Classes="chip" Background="{Binding TintBrush}" CornerRadius="4" Padding="6,1" Margin="0,0,4,2">
                              <StackPanel Orientation="Horizontal" Spacing="4">
                                <Border Width="6" Height="6" CornerRadius="3" Background="{Binding Brush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Name}" FontSize="12" />
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Classes="empty"
                        IsVisible="{Binding ListEmptyState, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static main:EmptyState.NoAccounts}}">
              <PathIcon Data="{StaticResource Icon.AddAccount}" />
              <TextBlock Classes="secondary" Text="{loc:Loc Empty_NoAccounts}" />
              <Button Classes="accent" HorizontalAlignment="Center" Command="{Binding AddAccountCommand}"
                      Content="{loc:Loc Toolbar_AddAccount}" />
            </StackPanel>
            <StackPanel Classes="empty"
                        IsVisible="{Binding ListEmptyState, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static main:EmptyState.EmptyView}}">
              <PathIcon Data="{StaticResource Icon.Mail}" />
              <TextBlock Classes="secondary" Text="{loc:Loc Empty_View}" />
            </StackPanel>
            <StackPanel Classes="empty"
                        IsVisible="{Binding ListEmptyState, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static main:EmptyState.NoSearchResults}}">
              <PathIcon Data="{StaticResource Icon.Search}" />
              <TextBlock Classes="secondary" Text="{loc:Loc Empty_Search}" />
            </StackPanel>
          </Grid>
        </DockPanel>
      </Border>

      <GridSplitter Grid.Column="3" Width="4" IsVisible="{Binding !IsAccountPageShown}" />

      <Border x:Name="ReaderPane" Grid.Column="4" Background="{DynamicResource Brush.Surface}" BorderThickness="1,0,0,0"
              BorderBrush="{DynamicResource Brush.Border}" IsVisible="{Binding !IsAccountPageShown}">
        <DockPanel>
          <Border x:Name="NewMailBar" DockPanel.Dock="Top" Padding="12,4" Background="{DynamicResource Brush.AccentSubtle}"
                  BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Brush.Border}" IsVisible="{Binding NewMail, Converter={x:Static ObjectConverters.IsNotNull}}">
            <StackPanel Orientation="Horizontal" Spacing="8" DataContext="{Binding NewMail}">
              <TextBlock Classes="caption" VerticalAlignment="Center" Text="{loc:Loc Reader_NewMail}" />
              <Button x:Name="NewMailPreviousButton" Classes="icon" Command="{Binding PreviousCommand}"
                      ToolTip.Tip="{loc:Loc Notification_Previous}" AutomationProperties.Name="{loc:Loc Notification_Previous}">
                <PathIcon Data="{StaticResource Icon.ChevronLeft}" />
              </Button>
              <TextBlock Classes="caption" VerticalAlignment="Center" Text="{Binding PositionText}" />
              <Button x:Name="NewMailNextButton" Classes="icon" Command="{Binding NextCommand}"
                      ToolTip.Tip="{loc:Loc Notification_Next}" AutomationProperties.Name="{loc:Loc Notification_Next}">
                <PathIcon Data="{StaticResource Icon.ChevronRight}" />
              </Button>
            </StackPanel>
          </Border>
          <WrapPanel x:Name="ReaderActions" DockPanel.Dock="Top" Margin="8" IsVisible="{Binding !IsNoMessageSelected}">
            <Button Classes="icon" Command="{Binding ReplyCommand}"
                    ToolTip.Tip="{loc:Loc Toolbar_Reply}" AutomationProperties.Name="{loc:Loc Toolbar_Reply}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{StaticResource Icon.Reply}" />
                <TextBlock Text="{loc:Loc Toolbar_Reply}" />
              </StackPanel>
            </Button>
            <Button Classes="icon" Command="{Binding ForwardCommand}"
                    ToolTip.Tip="{loc:Loc Toolbar_Forward}" AutomationProperties.Name="{loc:Loc Toolbar_Forward}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{StaticResource Icon.Forward}" />
                <TextBlock Text="{loc:Loc Toolbar_Forward}" />
              </StackPanel>
            </Button>
            <Button Classes="icon" Command="{Binding ToggleFlagCommand}"
                    ToolTip.Tip="{loc:Loc Toolbar_Star}" AutomationProperties.Name="{loc:Loc Toolbar_Star}">
              <PathIcon Classes="star" Classes.flagged="{Binding SelectedMessage.IsFlagged, FallbackValue=False}" />
            </Button>
            <Button Classes="icon" ToolTip.Tip="{loc:Loc Toolbar_Labels}" AutomationProperties.Name="{loc:Loc Toolbar_Labels}">
              <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedLeft">
                <StackPanel Spacing="4" MinWidth="180">
                  <ItemsControl ItemsSource="{Binding MessageLabelChoices}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="main:MessageLabelChoiceViewModel">
                        <CheckBox IsChecked="{Binding IsAssigned}" Command="{Binding ToggleCommand}" CommandParameter="{Binding}">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border Width="10" Height="10" CornerRadius="5" Background="{Binding Brush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Name}" />
                          </StackPanel>
                        </CheckBox>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Separator />
                  <Button Content="{loc:Loc Labels_Manage}" Command="{Binding ManageLabelsCommand}" HorizontalAlignment="Stretch" />
                </StackPanel>
              </Flyout>
              </Button.Flyout>
              <PathIcon Data="{StaticResource Icon.Tag}" />
            </Button>
            <Button Classes="icon" Command="{Binding OpenHtmlCommand}"
                    ToolTip.Tip="{loc:Loc Toolbar_ViewInBrowser}" AutomationProperties.Name="{loc:Loc Toolbar_ViewInBrowser}">
              <PathIcon Data="{StaticResource Icon.Browser}" />
            </Button>
            <Button Classes="icon" Command="{Binding ArchiveSelectedCommand}"
                    ToolTip.Tip="{loc:Loc Toolbar_Archive}" AutomationProperties.Name="{loc:Loc Toolbar_Archive}">
              <PathIcon Data="{StaticResource Icon.Archive}" />
            </Button>
            <Button Classes="icon" Command="{Binding DeleteSelectedCommand}"
                    ToolTip.Tip="{loc:Loc Toolbar_Delete}" AutomationProperties.Name="{loc:Loc Toolbar_Delete}">
              <PathIcon Data="{StaticResource Icon.Delete}" />
            </Button>
          </WrapPanel>
          <Grid>
            <StackPanel Classes="empty" IsVisible="{Binding IsNoMessageSelected}">
              <PathIcon Data="{StaticResource Icon.Mail}" />
              <TextBlock Classes="secondary" Text="{loc:Loc Reader_Placeholder}" />
            </StackPanel>
            <ContentControl Content="{Binding SelectedMessage}">
            <ContentControl.DataTemplates>
              <DataTemplate DataType="main:MessageItemViewModel">
                <DockPanel Margin="16">
                  <StackPanel DockPanel.Dock="Top" Spacing="12">
                    <TextBlock Classes="title" Text="{Binding Subject}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding Subject}" />
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                      <Border Width="40" Height="40" CornerRadius="20" Background="{Binding SenderBrush}" VerticalAlignment="Top">
                        <TextBlock Text="{Binding SenderInitial}" Foreground="White" FontSize="16" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                      </Border>
                      <Grid Grid.Column="1" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="2">
                        <TextBlock Grid.Row="0" Classes="secondary" Text="{loc:Loc Reader_From}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding FromFull}" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="1" Classes="caption" Text="{loc:Loc Reader_To}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Classes="caption" Text="{Binding Recipients}" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="2" Classes="caption" Text="{loc:Loc Reader_Time}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Classes="caption" Text="{Binding SentAtText}" />
                      </Grid>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Attachments}" IsVisible="{Binding HasAttachments}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="main:AttachmentItemViewModel">
                          <Button Command="{Binding SaveCommand}" Margin="0,0,8,8" Padding="12,8" CornerRadius="12"
                                  Background="{DynamicResource Brush.WindowBg}" BorderThickness="1"
                                  BorderBrush="{DynamicResource Brush.Border}" ToolTip.Tip="{Binding Label}"
                                  AutomationProperties.Name="{Binding Label}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <PathIcon Data="{StaticResource Icon.Attach}" />
                              <StackPanel>
                                <TextBlock Text="{Binding FileName}" MaxWidth="180" TextTrimming="CharacterEllipsis" />
                                <TextBlock Classes="caption" Text="{Binding SizeText}" />
                              </StackPanel>
                              <PathIcon Data="{StaticResource Icon.Download}" />
                            </StackPanel>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Height="1" Margin="0,0,0,12" Background="{DynamicResource Brush.Border}" />
                  </StackPanel>
                  <Border DockPanel.Dock="Top" IsVisible="{Binding HasBlockedRemoteImages}" Padding="12,8" Margin="0,0,0,8"
                          Background="{DynamicResource Brush.WarningBg}" CornerRadius="8">
                    <DockPanel>
                      <SplitButton DockPanel.Dock="Right" Content="{loc:Loc Reader_LoadImages}" Command="{Binding LoadRemoteImagesCommand}">
                        <SplitButton.Flyout>
                          <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuItem Header="{Binding AlwaysAllowSenderText}" Command="{Binding AlwaysAllowSenderCommand}"
                                      IsVisible="{Binding CanRememberSender}" />
                            <MenuItem Header="{Binding AlwaysAllowDomainText}" Command="{Binding AlwaysAllowDomainCommand}"
                                      IsVisible="{Binding CanRememberSender}" />
                          </MenuFlyout>
                        </SplitButton.Flyout>
                      </SplitButton>
                      <TextBlock Text="{loc:Loc Reader_RemoteImagesBlocked}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </DockPanel>
                  </Border>
                  <Grid>
                    <ctl:HtmlBodyView Document="{Binding HtmlDocument}" IsVisible="{Binding HasHtml}" />
                    <ScrollViewer IsVisible="{Binding !HasHtml}">
                      <SelectableTextBlock Text="{Binding BodyText}" TextWrapping="Wrap" />
                    </ScrollViewer>
                  </Grid>
                </DockPanel>
              </DataTemplate>
            </ContentControl.DataTemplates>
            </ContentControl>
          </Grid>
        </DockPanel>
      </Border>

      <!-- Takes the place of the message list and the reading pane while an account is selected. -->
      <ContentControl x:Name="AccountPane" Grid.Column="2" Grid.ColumnSpan="3" Content="{Binding AccountPage}"
                      IsVisible="{Binding IsAccountPageShown}" HorizontalContentAlignment="Stretch"
                      VerticalContentAlignment="Stretch">
        <ContentControl.ContentTemplate>
          <DataTemplate DataType="main:AccountPageViewModel">
            <views:AccountPage />
          </DataTemplate>
        </ContentControl.ContentTemplate>
      </ContentControl>
    </Grid>
  </DockPanel>
</Window>
