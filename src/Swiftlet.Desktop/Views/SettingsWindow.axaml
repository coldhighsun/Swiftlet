<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:settings="using:Swiftlet.Desktop.ViewModels.Settings"
        xmlns:loc="using:Swiftlet.Desktop.Localization"
        x:Class="Swiftlet.Desktop.Views.SettingsWindow"
        Icon="avares://Swiftlet.Desktop/Assets/swiftlet.ico"
        x:DataType="settings:SettingsViewModel"
        Title="{loc:Loc Settings_Title}" Width="520" Height="640" CanResize="False"
        WindowStartupLocation="CenterOwner">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Padding="16,12" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Brush.Border}">
      <Button HorizontalAlignment="Right" MinWidth="88" HorizontalContentAlignment="Center"
              Content="{loc:Loc Common_Close}" Command="{Binding CloseCommand}" IsCancel="True" />
    </Border>
    <TextBlock DockPanel.Dock="Bottom" Classes="error" Margin="16,0,16,8" Text="{Binding ErrorText}" TextWrapping="Wrap"
               IsVisible="{Binding ErrorText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="16" Spacing="12">
        <Border Classes="card">
          <StackPanel Spacing="12">
            <TextBlock Classes="section" Text="{loc:Loc Settings_SectionGeneral}" />
            <Grid ColumnDefinitions="120,*" IsVisible="{Binding LanguageSelector, Converter={x:Static ObjectConverters.IsNotNull}}">
              <TextBlock Text="{loc:Loc Toolbar_Language}" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding LanguageSelector.Options}"
                        SelectedItem="{Binding LanguageSelector.SelectedOption}">
                <ComboBox.ItemTemplate>
                  <DataTemplate DataType="settings:LanguageOptionViewModel">
                    <TextBlock Text="{Binding DisplayName}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </Grid>
            <Grid ColumnDefinitions="120,*">
              <TextBlock Text="{loc:Loc Settings_Theme}" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding ThemeOptions}"
                        SelectedItem="{Binding SelectedTheme}">
                <ComboBox.ItemTemplate>
                  <DataTemplate DataType="settings:ThemeOptionViewModel">
                    <TextBlock Text="{Binding DisplayName}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </Grid>
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel Spacing="8">
            <TextBlock Classes="section" Text="{loc:Loc Settings_SectionSync}" />
            <CheckBox Content="{loc:Loc Settings_DownloadHistory}" IsChecked="{Binding DownloadFullHistory}" />
            <TextBlock Classes="caption" Text="{loc:Loc Settings_DownloadHistoryHint}" TextWrapping="Wrap" Margin="28,0,0,0" />
            <CheckBox Content="{loc:Loc Settings_DownloadAllMail}" IsChecked="{Binding DownloadAllMail}" Margin="28,0,0,0" />
            <TextBlock Classes="caption" Text="{loc:Loc Settings_DownloadAllMailHint}" TextWrapping="Wrap" Margin="56,0,0,0" />
            <CheckBox Content="{loc:Loc Settings_RemoveServerDeleted}" IsChecked="{Binding RemoveServerDeletedMessages}" Margin="0,8,0,0" />
            <TextBlock Classes="caption" Text="{loc:Loc Settings_RemoveServerDeletedHint}" TextWrapping="Wrap" Margin="28,0,0,0" />
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel Spacing="8">
            <TextBlock Classes="section" Text="{loc:Loc Settings_RemoteImages}" />
            <TextBlock Classes="caption" Text="{loc:Loc Settings_RemoteImagesHint}" TextWrapping="Wrap" />
            <TextBox Text="{Binding RemoteImageFilter}" PlaceholderText="{loc:Loc Settings_RemoteImagesFilter}" />
            <ListBox ItemsSource="{Binding RemoteImageRules}" SelectedItem="{Binding SelectedRemoteImageRule}" MaxHeight="160" MinHeight="80" />
            <TextBlock Classes="caption" Text="{Binding RemoteImageRuleCountText}" />
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
              <TextBox Text="{Binding NewRemoteImageRule}" PlaceholderText="{loc:Loc Settings_RemoteImagesPlaceholder}" />
              <Button Grid.Column="1" Content="{loc:Loc Settings_RemoteImagesAdd}" Command="{Binding AddRemoteImageRuleCommand}" />
              <Button Grid.Column="2" Content="{loc:Loc Settings_RemoteImagesRemove}" Command="{Binding RemoveRemoteImageRuleCommand}" />
            </Grid>
          </StackPanel>
        </Border>

        <Border Classes="card" IsVisible="{Binding DatabaseStatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <StackPanel Spacing="8">
            <TextBlock Classes="section" Text="{loc:Loc Settings_SectionData}" />
            <TextBlock Classes="secondary" Text="{Binding DatabaseStatusText}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
