<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Swiftlet.Desktop.ViewModels"
        xmlns:loc="using:Swiftlet.Desktop.Localization"
        x:Class="Swiftlet.Desktop.Views.NewMailWindow"
        Icon="avares://Swiftlet/Assets/swiftlet.ico"
        x:DataType="vm:NewMailViewModel"
        Title="Swiftlet" Width="360" SizeToContent="Height" CanResize="False"
        WindowDecorations="None" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        WindowStartupLocation="Manual"
        Background="Transparent" TransparencyLevelHint="Transparent">
  <Window.Styles>
    <!-- The large text area is a button, but it should not change color under the pointer. -->
    <Style Selector="Button#OpenButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button#OpenButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <!-- The round arrow buttons inside the pager. -->
    <Style Selector="Button.pager">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="MinWidth" Value="24" />
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
  </Window.Styles>
  <!-- The window itself is transparent, so only this card with its round corners is seen. -->
  <Border x:Name="Card" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}"
          BorderThickness="1" CornerRadius="12" ClipToBounds="True">
    <StackPanel>
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Classes="caption" Text="{Binding Title}" Margin="16,0,8,0" VerticalAlignment="Center" />
        <Button x:Name="CloseButton" Grid.Column="1" Classes="icon" Margin="0,4,4,0"
                Command="{Binding CloseCommand}" ToolTip.Tip="{loc:Loc Common_Close}"
                AutomationProperties.Name="{loc:Loc Common_Close}">
          <PathIcon Data="{StaticResource Icon.Close}" Width="12" Height="12" />
        </Button>
      </Grid>

      <!-- The text area keeps its height from message to message, so the action buttons stay where they are. -->
      <Button x:Name="OpenButton" Classes="icon" Padding="16,4" Height="112" HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top" Command="{Binding OpenCommand}"
              ToolTip.Tip="{loc:Loc Notification_Open}" AutomationProperties.Name="{loc:Loc Notification_Open}">
        <StackPanel Spacing="4">
          <TextBlock Text="{Binding Sender}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxLines="1"
                     ToolTip.Tip="{Binding Sender}" />
          <TextBlock Text="{Binding Subject}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2" />
          <TextBlock Classes="secondary" Text="{Binding Preview}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2" />
        </StackPanel>
      </Button>

      <TextBlock Classes="caption" Text="{Binding AccountAddress}" Margin="16,4,16,0"
                 TextTrimming="CharacterEllipsis" MaxLines="1" ToolTip.Tip="{Binding AccountAddress}" />
      <TextBlock Classes="error" Text="{Binding Error}" Margin="16,4,16,0" TextWrapping="Wrap"
                 IsVisible="{Binding HasError}" />

      <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" Margin="16,4,8,8">
        <!-- A compact pill, so moving between messages weighs less than the actions on the shown one. -->
        <Border x:Name="Pager" Height="28" Padding="1" CornerRadius="12" BorderThickness="1"
                HorizontalAlignment="Left" VerticalAlignment="Center" IsVisible="{Binding HasSeveral}"
                Background="{DynamicResource Brush.WindowBg}" BorderBrush="{DynamicResource Brush.Border}">
          <StackPanel Orientation="Horizontal">
            <Button x:Name="PreviousButton" Classes="icon pager" Command="{Binding PreviousCommand}"
                    ToolTip.Tip="{loc:Loc Notification_Previous}"
                    AutomationProperties.Name="{loc:Loc Notification_Previous}">
              <PathIcon Data="{StaticResource Icon.ChevronLeft}" Width="10" Height="10" />
            </Button>
            <TextBlock Classes="caption" Text="{Binding Position}" MinWidth="32" Margin="2,0"
                       TextAlignment="Center" VerticalAlignment="Center" />
            <Button x:Name="NextButton" Classes="icon pager" Command="{Binding NextCommand}"
                    ToolTip.Tip="{loc:Loc Notification_Next}"
                    AutomationProperties.Name="{loc:Loc Notification_Next}">
              <PathIcon Data="{StaticResource Icon.ChevronRight}" Width="10" Height="10" />
            </Button>
          </StackPanel>
        </Border>
        <Button x:Name="StarButton" Grid.Column="2" Classes="icon" Command="{Binding StarCommand}"
                ToolTip.Tip="{loc:Loc Notification_Star}" AutomationProperties.Name="{loc:Loc Notification_Star}">
          <PathIcon Data="{StaticResource Icon.Star}" />
        </Button>
        <Button x:Name="MarkReadButton" Grid.Column="3" Classes="icon" Command="{Binding MarkReadCommand}"
                ToolTip.Tip="{loc:Loc Notification_MarkRead}" AutomationProperties.Name="{loc:Loc Notification_MarkRead}">
          <PathIcon Data="{StaticResource Icon.MailRead}" />
        </Button>
        <Button x:Name="ArchiveButton" Grid.Column="4" Classes="icon" Command="{Binding ArchiveCommand}"
                ToolTip.Tip="{Binding ArchiveHint}" ToolTip.ShowOnDisabled="True"
                AutomationProperties.Name="{loc:Loc Toolbar_Archive}">
          <PathIcon Data="{StaticResource Icon.Archive}" />
        </Button>
        <Button x:Name="DeleteButton" Grid.Column="5" Classes="icon danger" Command="{Binding DeleteCommand}"
                ToolTip.Tip="{Binding DeleteHint}" ToolTip.ShowOnDisabled="True"
                AutomationProperties.Name="{loc:Loc Toolbar_Delete}">
          <PathIcon Data="{StaticResource Icon.Delete}" />
        </Button>
      </Grid>
    </StackPanel>
  </Border>
</Window>
