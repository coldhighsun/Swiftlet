<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ai="using:Swiftlet.Desktop.ViewModels.Ai"
             xmlns:loc="using:Swiftlet.Desktop.Localization"
             x:Class="Swiftlet.Desktop.Views.AiPanel"
             x:DataType="ai:AiAssistViewModel">
  <Border Padding="12,8" Margin="0,0,0,8" Background="{DynamicResource Brush.AccentSubtle}" CornerRadius="8">
    <DockPanel>
      <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
        <TextBlock Classes="section" Text="{Binding Title}" VerticalAlignment="Center" />
        <!-- Plain radio buttons: a drop-down list would open over the native web view. -->
        <WrapPanel Grid.Column="1" VerticalAlignment="Center">
          <RadioButton Margin="0,0,12,0" GroupName="AiLanguage" Content="{loc:Loc Ai_LanguageChinese}"
                       IsChecked="{Binding IsChinese}" />
          <RadioButton GroupName="AiLanguage" Content="{loc:Loc Ai_LanguageEnglish}" IsChecked="{Binding IsEnglish}" />
        </WrapPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
          <Button Content="{loc:Loc Ai_Stop}" Command="{Binding StopCommand}" IsVisible="{Binding IsRunning}" />
          <Button Classes="icon" Command="{Binding RegenerateCommand}" IsVisible="{Binding !IsRunning}"
                  ToolTip.Tip="{loc:Loc Ai_Regenerate}" AutomationProperties.Name="{loc:Loc Ai_Regenerate}">
            <PathIcon Data="{StaticResource Icon.Sync}" />
          </Button>
          <Button Classes="icon" Command="{Binding CopyCommand}"
                  ToolTip.Tip="{loc:Loc Ai_Copy}" AutomationProperties.Name="{loc:Loc Ai_Copy}">
            <PathIcon Data="{StaticResource Icon.Copy}" />
          </Button>
          <Button Classes="icon" Command="{Binding CloseCommand}"
                  ToolTip.Tip="{loc:Loc Ai_ClosePanel}" AutomationProperties.Name="{loc:Loc Ai_ClosePanel}">
            <PathIcon Data="{StaticResource Icon.Close}" Width="12" Height="12" />
          </Button>
        </StackPanel>
      </Grid>
      <TextBlock DockPanel.Dock="Bottom" Classes="caption" Margin="0,4,0,0" Text="{Binding NoticeText}" TextWrapping="Wrap"
                 IsVisible="{Binding NoticeText, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <TextBlock DockPanel.Dock="Bottom" Classes="error" Margin="0,4,0,0" Text="{Binding ErrorText}" TextWrapping="Wrap"
                 IsVisible="{Binding ErrorText, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <StackPanel DockPanel.Dock="Top" Margin="0,8,0,0" Spacing="4" IsVisible="{Binding IsWaiting}">
        <TextBlock Classes="caption" Text="{loc:Loc Ai_Waiting}" />
        <ProgressBar IsIndeterminate="True" />
      </StackPanel>
      <!-- Plain text only: nothing the model writes is turned into a link or markup. Limited in height so the mail stays visible. -->
      <ScrollViewer MaxHeight="220" Margin="0,8,0,0" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding HasText}">
        <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" />
      </ScrollViewer>
    </DockPanel>
  </Border>
</UserControl>
