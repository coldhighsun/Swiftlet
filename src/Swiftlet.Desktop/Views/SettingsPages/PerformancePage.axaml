<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:settings="using:Swiftlet.Desktop.ViewModels.Settings"
             xmlns:loc="using:Swiftlet.Desktop.Localization"
             x:Class="Swiftlet.Desktop.Views.SettingsPages.PerformancePage"
             x:DataType="settings:SettingsViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="16" Spacing="12">
      <TextBlock Classes="title" Text="{loc:Loc Settings_PagePerformance}" />
      <Border Classes="card">
        <StackPanel Spacing="8">
          <CheckBox Content="{loc:Loc Settings_HardwareRendering}" IsChecked="{Binding UseHardwareRendering}" />
          <TextBlock Classes="caption" Text="{loc:Loc Settings_HardwareRenderingHint}" TextWrapping="Wrap" Margin="28,0,0,0" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
