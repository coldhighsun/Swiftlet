<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Swiftlet.Desktop.ViewModels.Main"
        x:Class="Swiftlet.Desktop.Views.AttachmentPreviewWindow"
        Icon="avares://Swiftlet.Desktop/Assets/swiftlet.ico"
        x:DataType="vm:AttachmentPreviewViewModel"
        Title="Swiftlet" Width="360" SizeToContent="Height" MaxHeight="420" CanResize="False"
        WindowDecorations="None" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        WindowStartupLocation="Manual" Focusable="False"
        Background="Transparent" TransparencyLevelHint="Transparent">
  <!-- The window itself is transparent, so only this card with its round corners is seen. -->
  <Border x:Name="Card" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}"
          BorderThickness="1" CornerRadius="12" ClipToBounds="True" Padding="16,12">
    <StackPanel Spacing="8">
      <StackPanel Spacing="2">
        <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxLines="1" />
        <TextBlock Classes="caption" Text="{Binding Details}" />
      </StackPanel>
      <Image x:Name="Thumbnail" Source="{Binding Image}" IsVisible="{Binding HasImage}" MaxHeight="300"
             Stretch="Uniform" HorizontalAlignment="Left" />
      <TextBlock x:Name="PreviewText" Text="{Binding Text}" IsVisible="{Binding HasText}" FontSize="12"
                 FontFamily="Cascadia Mono, Consolas, Menlo, monospace" TextWrapping="Wrap" MaxLines="14"
                 TextTrimming="CharacterEllipsis" />
      <TextBlock x:Name="PreviewMessage" Classes="secondary" Text="{Binding Message}" IsVisible="{Binding HasMessage}"
                 TextWrapping="Wrap" />
    </StackPanel>
  </Border>
</Window>
