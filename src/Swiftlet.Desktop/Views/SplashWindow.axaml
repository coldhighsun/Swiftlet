<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Swiftlet.Desktop.ViewModels"
        x:Class="Swiftlet.Desktop.Views.SplashWindow"
        Icon="avares://Swiftlet/Assets/swiftlet.ico"
        x:DataType="vm:SplashViewModel"
        Title="Swiftlet" Width="360" SizeToContent="Height" CanResize="False"
        WindowDecorations="None" WindowStartupLocation="CenterScreen"
        Background="Transparent" TransparencyLevelHint="Transparent">
  <!-- The window itself is transparent, so only this card with its round corners is seen. -->
  <Border x:Name="Card" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}"
          BorderThickness="1" CornerRadius="12" ClipToBounds="True">
    <StackPanel Margin="24" Spacing="16">
      <PathIcon Data="{StaticResource Icon.Logo}" Width="64" Height="54" HorizontalAlignment="Center"
                Foreground="{DynamicResource Brush.Accent}" />
      <StackPanel Spacing="4">
        <TextBlock Classes="title" Text="Swiftlet" HorizontalAlignment="Center" />
        <TextBlock Classes="caption" Text="{Binding Version}" HorizontalAlignment="Center" />
      </StackPanel>
      <ProgressBar IsIndeterminate="True" />
      <TextBlock Classes="secondary" Text="{Binding Status}" HorizontalAlignment="Center" TextAlignment="Center"
                 TextWrapping="Wrap" />
    </StackPanel>
  </Border>
</Window>
