<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Swiftlet.Desktop.ViewModels"
        xmlns:loc="using:Swiftlet.Desktop.Localization"
        xmlns:ctl="using:Swiftlet.Desktop.Controls"
        x:Class="Swiftlet.Desktop.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Swiftlet" Width="1200" Height="760" MinWidth="800" MinHeight="480">
  <Window.Styles>
    <Style Selector="TextBlock.unread">
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="TreeViewItem">
      <Setter Property="IsExpanded" Value="True" />
    </Style>
  </Window.Styles>

  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="8" BorderThickness="0,0,0,1"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Button Content="{loc:Loc Toolbar_Compose}" Command="{Binding ComposeCommand}" />
          <Button Content="{loc:Loc Toolbar_Reply}" Command="{Binding ReplyCommand}" />
          <Button Content="{loc:Loc Toolbar_Forward}" Command="{Binding ForwardCommand}" />
          <Button Content="{loc:Loc Toolbar_Star}" Command="{Binding ToggleFlagCommand}" />
          <Button Content="{loc:Loc Toolbar_Labels}">
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedLeft">
                <StackPanel Spacing="4" MinWidth="180">
                  <ItemsControl ItemsSource="{Binding MessageLabelChoices}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="vm:MessageLabelChoiceViewModel">
                        <CheckBox IsChecked="{Binding IsAssigned}" Command="{Binding ToggleCommand}" CommandParameter="{Binding}">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border Width="10" Height="10" CornerRadius="5" Background="{Binding Brush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Name}" />
                          </StackPanel>
                        </CheckBox>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Separator />
                  <Button Content="{loc:Loc Labels_Manage}" Command="{Binding ManageLabelsCommand}" HorizontalAlignment="Stretch" />
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>
          <Button Content="{loc:Loc Toolbar_Delete}" Command="{Binding DeleteSelectedCommand}" />
          <Button Content="{loc:Loc Toolbar_ViewInBrowser}" Command="{Binding OpenHtmlCommand}" />
          <Button Content="{loc:Loc Toolbar_Sync}" Command="{Binding SyncCommand}" />
          <Button Content="{loc:Loc Toolbar_AddAccount}" Command="{Binding AddAccountCommand}" />
          <Button Content="{loc:Loc Toolbar_Settings}" Command="{Binding OpenSettingsCommand}" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
          <ComboBox Width="140" ItemsSource="{Binding LanguageSelector.Options}"
                    SelectedItem="{Binding LanguageSelector.SelectedOption}"
                    ToolTip.Tip="{loc:Loc Toolbar_Language}">
            <ComboBox.ItemTemplate>
              <DataTemplate DataType="vm:LanguageOptionViewModel">
                <TextBlock Text="{Binding DisplayName}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBox Width="190" PlaceholderText="{loc:Loc Search_Placeholder}" Text="{Binding SearchText}">
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}" />
            </TextBox.KeyBindings>
          </TextBox>
        </StackPanel>
      </Grid>
    </Border>

    <Border DockPanel.Dock="Bottom" Padding="10,4" BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        <ProgressBar Grid.Column="1" Width="120" IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
      </Grid>
    </Border>

    <Grid ColumnDefinitions="240,Auto,400,Auto,*">
      <TreeView Grid.Column="0" ItemsSource="{Binding TreeRoots}" SelectedItem="{Binding SelectedNode}" Margin="4">
        <TreeView.DataTemplates>
          <TreeDataTemplate DataType="vm:AccountNodeViewModel" ItemsSource="{Binding Folders}">
            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold">
              <TextBlock.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="{loc:Loc Menu_Account_Delete}"
                            Command="{Binding $parent[TreeView].((vm:MainWindowViewModel)DataContext).DeleteAccountCommand}"
                            CommandParameter="{Binding}" />
                  <MenuItem Header="{loc:Loc Menu_Account_Reauthenticate}" IsVisible="{Binding CanReauthenticate}"
                            Command="{Binding $parent[TreeView].((vm:MainWindowViewModel)DataContext).ReauthenticateAccountCommand}"
                            CommandParameter="{Binding}" />
                </ContextMenu>
              </TextBlock.ContextMenu>
            </TextBlock>
          </TreeDataTemplate>
          <DataTemplate DataType="vm:UnifiedInboxNodeViewModel">
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
          </DataTemplate>
          <DataTemplate DataType="vm:LabelNodeViewModel">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Border Width="10" Height="10" CornerRadius="5" Background="{Binding Brush}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding Name}" />
            </StackPanel>
          </DataTemplate>
          <DataTemplate DataType="vm:FolderNodeViewModel">
            <TextBlock Text="{Binding Name}">
              <TextBlock.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="{loc:Loc Menu_Folder_Empty}" IsEnabled="{Binding CanEmpty}"
                            Command="{Binding $parent[TreeView].((vm:MainWindowViewModel)DataContext).EmptyFolderCommand}"
                            CommandParameter="{Binding}" />
                </ContextMenu>
              </TextBlock.ContextMenu>
            </TextBlock>
          </DataTemplate>
        </TreeView.DataTemplates>
      </TreeView>

      <GridSplitter Grid.Column="1" Width="4" />

      <ListBox Grid.Column="2" ItemsSource="{Binding Messages}" SelectedItem="{Binding SelectedMessage}"
               SelectionMode="Multiple" SelectedItems="{Binding SelectedMessages}"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               ScrollViewer.ScrollChanged="OnMessageListScrollChanged">
        <ListBox.KeyBindings>
          <KeyBinding Gesture="Delete" Command="{Binding DeleteSelectedCommand}" />
        </ListBox.KeyBindings>
        <ListBox.ContextMenu>
          <ContextMenu>
            <MenuItem Header="{loc:Loc Toolbar_Delete}" Command="{Binding DeleteSelectedCommand}" />
          </ContextMenu>
        </ListBox.ContextMenu>
        <ListBox.ItemTemplate>
          <DataTemplate DataType="vm:MessageItemViewModel">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" Margin="2,4">
              <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding FromDisplay}"
                         Classes.unread="{Binding !IsRead}" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SentAtText}" FontSize="12" Opacity="0.6" />
              <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding Subject}"
                         Classes.unread="{Binding !IsRead}" TextTrimming="CharacterEllipsis" />
              <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="4">
                <TextBlock Text="📎" IsVisible="{Binding HasAttachments}" />
                <TextBlock Text="{Binding FlagGlyph}" />
              </StackPanel>
              <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Preview}" FontSize="12" Opacity="0.6"
                         TextTrimming="CharacterEllipsis" />
              <ItemsControl Grid.Row="3" Grid.ColumnSpan="2" ItemsSource="{Binding Labels}" IsVisible="{Binding HasLabels}"
                            Margin="0,2,0,0">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="vm:LabelChipViewModel">
                    <Border Background="{Binding Brush}" CornerRadius="3" Padding="5,1" Margin="0,0,4,2">
                      <TextBlock Text="{Binding Name}" FontSize="11" Foreground="White" />
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <GridSplitter Grid.Column="3" Width="4" />

      <Grid Grid.Column="4">
        <TextBlock Text="{loc:Loc Reader_Placeholder}" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Opacity="0.5" IsVisible="{Binding IsNoMessageSelected}" />
        <ContentControl Content="{Binding SelectedMessage}">
          <ContentControl.DataTemplates>
            <DataTemplate DataType="vm:MessageItemViewModel">
              <DockPanel Margin="16">
                <StackPanel DockPanel.Dock="Top" Spacing="4">
                  <TextBlock Text="{Binding Subject}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="6" RowSpacing="2">
                    <TextBlock Grid.Row="0" Text="{loc:Loc Reader_From}" Opacity="0.6" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding FromFull}" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="1" Text="{loc:Loc Reader_To}" Opacity="0.6" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Recipients}" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="2" Text="{loc:Loc Reader_Time}" Opacity="0.6" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SentAtText}" />
                  </Grid>
                  <ItemsControl ItemsSource="{Binding Attachments}" IsVisible="{Binding HasAttachments}" Margin="0,8,0,0">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="vm:AttachmentItemViewModel">
                        <Button Content="{Binding Label}" Command="{Binding SaveCommand}" Margin="0,0,6,6" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Separator Margin="0,8" />
                </StackPanel>
                <Border DockPanel.Dock="Top" IsVisible="{Binding HasBlockedRemoteImages}" Padding="8,6" Margin="0,0,0,6"
                        Background="{DynamicResource SystemFillColorCautionBackgroundBrush}" CornerRadius="4">
                  <DockPanel>
                    <SplitButton DockPanel.Dock="Right" Content="{loc:Loc Reader_LoadImages}" Command="{Binding LoadRemoteImagesCommand}">
                      <SplitButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                          <MenuItem Header="{Binding AlwaysAllowSenderText}" Command="{Binding AlwaysAllowSenderCommand}"
                                    IsVisible="{Binding CanRememberSender}" />
                          <MenuItem Header="{Binding AlwaysAllowDomainText}" Command="{Binding AlwaysAllowDomainCommand}"
                                    IsVisible="{Binding CanRememberSender}" />
                        </MenuFlyout>
                      </SplitButton.Flyout>
                    </SplitButton>
                    <TextBlock Text="{loc:Loc Reader_RemoteImagesBlocked}" VerticalAlignment="Center" TextWrapping="Wrap" />
                  </DockPanel>
                </Border>
                <Grid>
                  <ctl:HtmlBodyView Document="{Binding HtmlDocument}" IsVisible="{Binding HasHtml}" />
                  <ScrollViewer IsVisible="{Binding !HasHtml}">
                    <SelectableTextBlock Text="{Binding BodyText}" TextWrapping="Wrap" />
                  </ScrollViewer>
                </Grid>
              </DockPanel>
            </DataTemplate>
          </ContentControl.DataTemplates>
        </ContentControl>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
