<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Swiftlet.Desktop.ViewModels"
        xmlns:loc="using:Swiftlet.Desktop.Localization"
        xmlns:accounts="using:Swiftlet.Domain.Accounts"
        x:Class="Swiftlet.Desktop.ComposeWindow"
        Icon="avares://Swiftlet.Desktop/Assets/swiftlet.ico"
        x:DataType="vm:ComposeViewModel"
        Title="{Binding Title}" Width="780" Height="660" MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterOwner">
  <Window.Styles>
    <Style Selector="Border.separator">
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
    </Style>
  </Window.Styles>

  <DockPanel Margin="16">
    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*,Auto" Margin="0,12,0,0">
      <Button Content="{loc:Loc Compose_AddAttachment}" Command="{Binding AddAttachmentsCommand}" />
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
        <ProgressBar Width="80" MinWidth="80" IsIndeterminate="True" IsVisible="{Binding IsSending}" />
        <Button Content="{loc:Loc Common_Cancel}" Command="{Binding CancelCommand}" />
        <Button Content="{loc:Loc Compose_Send}" Command="{Binding SendCommand}" Classes="accent" MinWidth="88"
                HorizontalContentAlignment="Center" />
      </StackPanel>
    </Grid>
    <TextBlock DockPanel.Dock="Bottom" Classes="error" Text="{Binding ErrorMessage}" TextWrapping="Wrap" Margin="0,8,0,0"
               IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

    <Border Classes="card" Padding="12">
      <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="80,*" RowDefinitions="44,44,44,44,44">
          <Border Grid.Row="0" Grid.ColumnSpan="2" Classes="separator" />
          <TextBlock Grid.Row="0" Classes="secondary" Text="{loc:Loc Compose_From}" VerticalAlignment="Center" />
          <ComboBox Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                    Background="Transparent" BorderThickness="0"
                    ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}">
            <ComboBox.ItemTemplate>
              <DataTemplate DataType="accounts:MailAccount">
                <TextBlock Text="{Binding EmailAddress}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Border Grid.Row="1" Grid.ColumnSpan="2" Classes="separator" />
          <TextBlock Grid.Row="1" Classes="secondary" Text="{loc:Loc Compose_To}" VerticalAlignment="Center" />
          <TextBox Grid.Row="1" Grid.Column="1" Classes="flat" Text="{Binding To}" PlaceholderText="{loc:Loc Compose_RecipientsPlaceholder}" VerticalAlignment="Center" />
          <Border Grid.Row="2" Grid.ColumnSpan="2" Classes="separator" />
          <TextBlock Grid.Row="2" Classes="secondary" Text="{loc:Loc Compose_Cc}" VerticalAlignment="Center" />
          <TextBox Grid.Row="2" Grid.Column="1" Classes="flat" Text="{Binding Cc}" VerticalAlignment="Center" />
          <Border Grid.Row="3" Grid.ColumnSpan="2" Classes="separator" />
          <TextBlock Grid.Row="3" Classes="secondary" Text="{loc:Loc Compose_Bcc}" VerticalAlignment="Center" />
          <TextBox Grid.Row="3" Grid.Column="1" Classes="flat" Text="{Binding Bcc}" VerticalAlignment="Center" />
          <Border Grid.Row="4" Grid.ColumnSpan="2" Classes="separator" />
          <TextBlock Grid.Row="4" Classes="secondary" Text="{loc:Loc Compose_Subject}" VerticalAlignment="Center" />
          <TextBox Grid.Row="4" Grid.Column="1" Classes="flat" Text="{Binding Subject}" VerticalAlignment="Center" />
        </Grid>

        <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding Attachments}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vm:ComposeAttachmentViewModel">
              <Border Padding="12,4,4,4" Margin="0,8,8,0" CornerRadius="12" BorderThickness="1"
                      BorderBrush="{DynamicResource Brush.Border}" Background="{DynamicResource Brush.WindowBg}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <PathIcon Data="{StaticResource Icon.Attach}" Width="16" Height="16" />
                  <TextBlock Text="{Binding Label}" VerticalAlignment="Center" MaxWidth="240" TextTrimming="CharacterEllipsis" />
                  <Button Classes="icon" Padding="6" Command="{Binding RemoveCommand}"
                          ToolTip.Tip="{loc:Loc Compose_RemoveAttachment}"
                          AutomationProperties.Name="{loc:Loc Compose_RemoveAttachment}">
                    <PathIcon Data="{StaticResource Icon.Close}" />
                  </Button>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBox Classes="flat" Text="{Binding Body}" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                 Margin="0,8,0,0" />
      </DockPanel>
    </Border>
  </DockPanel>
</Window>
