<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Swiftlet.Desktop.ViewModels"
        xmlns:loc="using:Swiftlet.Desktop.Localization"
        xmlns:accounts="using:Swiftlet.Domain.Accounts"
        x:Class="Swiftlet.Desktop.ComposeWindow"
        Icon="avares://Swiftlet.Desktop/Assets/swiftlet.ico"
        x:DataType="vm:ComposeViewModel"
        Title="{Binding Title}" Width="780" Height="660" MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="12">
    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="0,10,0,0">
      <TextBlock Text="{Binding ErrorMessage}" Foreground="IndianRed" TextWrapping="Wrap" VerticalAlignment="Center"
                 IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <ProgressBar Width="80" IsIndeterminate="True" IsVisible="{Binding IsSending}" />
        <Button Content="{loc:Loc Common_Cancel}" Command="{Binding CancelCommand}" />
        <Button Content="{loc:Loc Compose_Send}" Command="{Binding SendCommand}" Classes="accent" />
      </StackPanel>
    </Grid>

    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="8">
      <TextBlock Grid.Row="0" Text="{loc:Loc Compose_From}" VerticalAlignment="Center" />
      <ComboBox Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch"
                ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}">
        <ComboBox.ItemTemplate>
          <DataTemplate DataType="accounts:MailAccount">
            <TextBlock Text="{Binding EmailAddress}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <TextBlock Grid.Row="1" Text="{loc:Loc Compose_To}" VerticalAlignment="Center" />
      <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding To}" PlaceholderText="{loc:Loc Compose_RecipientsPlaceholder}" />
      <TextBlock Grid.Row="2" Text="{loc:Loc Compose_Cc}" VerticalAlignment="Center" />
      <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Cc}" />
      <TextBlock Grid.Row="3" Text="{loc:Loc Compose_Bcc}" VerticalAlignment="Center" />
      <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Bcc}" />
      <TextBlock Grid.Row="4" Text="{loc:Loc Compose_Subject}" VerticalAlignment="Center" />
      <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Subject}" />
    </Grid>

    <StackPanel DockPanel.Dock="Top" Margin="0,8" Spacing="4">
      <Button Content="{loc:Loc Compose_AddAttachment}" Command="{Binding AddAttachmentsCommand}" HorizontalAlignment="Left" />
      <ItemsControl ItemsSource="{Binding Attachments}">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="vm:ComposeAttachmentViewModel">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
              <Button Content="✕" Command="{Binding RemoveCommand}" Padding="6,0" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <TextBox Text="{Binding Body}" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" />
  </DockPanel>
</Window>
