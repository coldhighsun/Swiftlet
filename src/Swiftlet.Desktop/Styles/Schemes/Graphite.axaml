<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- The graphite color scheme. It lies over Colors.axaml and defines the same keys. -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="Brush.Accent">#3F4954</SolidColorBrush>
      <SolidColorBrush x:Key="Brush.AccentHover">#2F3740</SolidColorBrush>
      <SolidColorBrush x:Key="Brush.AccentText">#2F3740</SolidColorBrush>
      <SolidColorBrush x:Key="Brush.OnAccent">#FFFFFF</SolidColorBrush>
      <SolidColorBrush x:Key="Brush.AccentSubtle">#E6E9EC</SolidColorBrush>
      <SolidColorBrush x:Key="Brush.WindowBg">#F7F7F8</SolidColorBrush>
      <SolidColorBrush x:Key="Brush.SidebarBg">#EEEFF1</SolidColorBrush>
      <SolidColorBrush x:Key="Brush.Surface">#FFFFFF</SolidColorBrush>
      <SolidColorBrush x:Key="Brush.Border">#DFE1E4</SolidColorBrush>
      <SolidColorBrush x:Key="Brush.TextPrimary">#17191C</SolidColorBrush>
      <SolidColorBrush x:Key="Brush.TextSecondary">#565C63</SolidColorBrush>
      <SolidColorBrush x:Key="Brush.Danger">#C0392B</SolidColorBrush>
      <SolidColorBrush x:Key="Brush.Star">#D98E04</SolidColorBrush>
      <SolidColorBrush x:Key="Brush.WarningBg">#FFF4D6</SolidColorBrush>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="Brush.Accent">#B4BDC7</SolidColorBrush>
      <SolidColorBrush x:Key="Brush.AccentHover">#C9D0D8</SolidColorBrush>
      <SolidColorBrush x:Key="Brush.AccentText">#B4BDC7</SolidColorBrush>
      <SolidColorBrush x:Key="Brush.OnAccent">#14181D</SolidColorBrush>
      <SolidColorBrush x:Key="Brush.AccentSubtle">#2C3137</SolidColorBrush>
      <SolidColorBrush x:Key="Brush.WindowBg">#121314</SolidColorBrush>
      <SolidColorBrush x:Key="Brush.SidebarBg">#17181A</SolidColorBrush>
      <SolidColorBrush x:Key="Brush.Surface">#1E2022</SolidColorBrush>
      <SolidColorBrush x:Key="Brush.Border">#313437</SolidColorBrush>
      <SolidColorBrush x:Key="Brush.TextPrimary">#E9EAEC</SolidColorBrush>
      <SolidColorBrush x:Key="Brush.TextSecondary">#A4A9AF</SolidColorBrush>
      <SolidColorBrush x:Key="Brush.Danger">#FF7A6B</SolidColorBrush>
      <SolidColorBrush x:Key="Brush.Star">#F2B33D</SolidColorBrush>
      <SolidColorBrush x:Key="Brush.WarningBg">#3A2F12</SolidColorBrush>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
