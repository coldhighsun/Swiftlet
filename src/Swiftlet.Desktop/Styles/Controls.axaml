<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        xmlns:controls="using:Swiftlet.Desktop.Controls"
        xmlns:loc="using:Swiftlet.Desktop.Localization">
  <!-- Shared style classes. Font sizes are 12, 14, 16 and 20; spacing steps are 4, 8, 12, 16 and 24. -->
  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource Brush.WindowBg}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontFamily" Value="fonts:Inter#Inter, Microsoft YaHei UI, PingFang SC, Noto Sans CJK SC" />
  </Style>

  <!-- Dialogs draw their own title row, 40 high including its separator. -->
  <Style Selector="controls|DialogFrame">
    <Setter Property="Template">
      <ControlTemplate>
        <DockPanel>
          <Border DockPanel.Dock="Top" Height="40" Background="{DynamicResource Brush.WindowBg}"
                  BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1"
                  chrome:WindowDecorationProperties.ElementRole="TitleBar">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Name="TitleText" Text="{TemplateBinding Title}" FontWeight="SemiBold" Margin="16,0,8,0"
                         VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              <Button Name="TitleCloseButton" Grid.Column="1" Classes="icon" Margin="0,0,4,0" Focusable="False"
                      VerticalAlignment="Center" ToolTip.Tip="{loc:Loc Common_Close}"
                      AutomationProperties.Name="{loc:Loc Common_Close}"
                      chrome:WindowDecorationProperties.ElementRole="User">
                <PathIcon Data="{StaticResource Icon.Close}" />
              </Button>
            </Grid>
          </Border>
          <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />
        </DockPanel>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
  </Style>
  <Style Selector="TextBlock.secondary">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
  </Style>
  <Style Selector="TextBlock.section">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.error">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
  </Style>

  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="16" />
  </Style>

  <!-- The primary button: the accent needs dark text in the dark theme, so the colors are set here. -->
  <Style Selector="Button.accent /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
  </Style>
  <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.AccentHover}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
  </Style>
  <Style Selector="Button.accent:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.AccentHover}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
  </Style>

  <!-- Text links without an underline. The theme underlines the text block inside a link, and its template colors the
       presenter per state, so both are overridden; the negative margin keeps the text aligned with its neighbours while
       the hover background has some room. -->
  <Style Selector="HyperlinkButton.link TextBlock">
    <Setter Property="TextDecorations" Value="{x:Null}" />
  </Style>
  <Style Selector="HyperlinkButton.link">
    <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="Margin" Value="-4,0" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}"
                          Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}"
                          Foreground="{TemplateBinding Foreground}" />
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="HyperlinkButton.link:pointerover">
    <Setter Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
  </Style>

  <!-- The 8px control radius would turn the small check box into a circle. -->
  <Style Selector="CheckBox">
    <Setter Property="CornerRadius" Value="4" />
  </Style>
  <!-- The accents of the dark theme are light, where the white check mark of the base theme is hard to see. -->
  <Style Selector="CheckBox:checked:not(:disabled) /template/ Path#CheckGlyph">
    <Setter Property="Fill" Value="{DynamicResource Brush.OnAccent}" />
  </Style>

  <Style Selector="Button.icon">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="8" />
  </Style>

  <!-- An address in the header of a message: reads as text, and shows that it can be clicked under the pointer. -->
  <Style Selector="Button.address">
    <Setter Property="Padding" Value="4,2" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="MinHeight" Value="0" />
  </Style>
  <Style Selector="ItemsControl.recipients Button.address">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
  </Style>

  <Style Selector="Button.icon:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- Icon toggle buttons: pressed in shows the same light accent as a selected row instead of the template's accent. -->
  <Style Selector="ToggleButton.icon">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="8" />
  </Style>
  <Style Selector="ToggleButton.icon:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
  </Style>
  <Style Selector="ToggleButton.icon:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
  </Style>
  <Style Selector="ToggleButton.icon:checked:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
  </Style>

  <!-- Selected rows: a light accent behind normal text. -->
  <Style Selector="TreeViewItem:selected /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
  </Style>
  <Style Selector="TreeViewItem:selected:pointerover /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
  </Style>

  <Style Selector="ListBox.messages ListBoxItem">
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.messages ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderThickness" Value="3,0,0,0" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>
  <Style Selector="ListBox.messages ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
  </Style>
  <Style Selector="ListBox.messages ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
  </Style>

  <!-- Saved rules: a framed list of rows with separators, and the small mark naming the kind of a rule. -->
  <Style Selector="Border.rules">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="ListBox.rules">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.rules ListBoxItem">
    <Setter Property="Padding" Value="12,4,4,4" />
  </Style>
  <Style Selector="ListBox.rules ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>
  <Style Selector="ListBox.rules ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
  </Style>
  <Style Selector="ListBox.rules ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
  </Style>
  <Style Selector="Border.tag">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="8,0" />
  </Style>

  <!-- Page navigation: a sidebar of entries next to the selected page. The template is replaced so the sidebar can have
       its own background. -->
  <Style Selector="TabControl.nav">
    <Setter Property="Padding" Value="0" />
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <StackPanel Spacing="4" />
      </ItemsPanelTemplate>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <DockPanel>
          <Border DockPanel.Dock="Left" Width="184" Padding="8" Background="{DynamicResource Brush.SidebarBg}"
                  BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Border}">
            <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
          </Border>
          <ContentPresenter Name="PART_SelectedContentHost" Content="{TemplateBinding SelectedContent}"
                            ContentTemplate="{TemplateBinding SelectedContentTemplate}" />
        </DockPanel>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="TabControl.nav > TabItem">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Padding" Value="8" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
  </Style>
  <Style Selector="TabControl.nav > TabItem:selected /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
  </Style>
  <Style Selector="TabControl.nav > TabItem:selected:pointerover /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
  </Style>
  <Style Selector="TabControl.nav > TabItem /template/ Border#PART_SelectedPipe">
    <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
  </Style>
  <Style Selector="TabControl.nav > TabItem > StackPanel > PathIcon">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
  </Style>

  <!-- Borderless inputs inside forms that draw their own row separators. -->
  <Style Selector="TextBox.flat /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="TextBox.flat:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="TextBox.flat:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="AutoCompleteBox.flat /template/ TextBox#PART_TextBox /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="AutoCompleteBox.flat /template/ TextBox#PART_TextBox:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="AutoCompleteBox.flat /template/ TextBox#PART_TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="Button.danger /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
  </Style>
  <Style Selector="Button.icon.danger /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <!-- Buttons made of an icon and a caption. -->
  <Style Selector="Button > StackPanel > PathIcon">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
  </Style>
  <Style Selector="Button.icon > PathIcon">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
  </Style>
  <!-- A smaller icon than other icon buttons have: it needs the class in its selector and a place after their style. -->
  <Style Selector="controls|DialogFrame /template/ Button.icon#TitleCloseButton > PathIcon">
    <Setter Property="Width" Value="12" />
    <Setter Property="Height" Value="12" />
  </Style>
  <Style Selector="PathIcon.star">
    <Setter Property="Data" Value="{StaticResource Icon.Star}" />
  </Style>
  <Style Selector="PathIcon.star.flagged">
    <Setter Property="Data" Value="{StaticResource Icon.StarFilled}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Star}" />
  </Style>

  <!-- Last, so the colors set above never hide that a button cannot be pressed. -->
  <Style Selector="Button.accent:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ButtonBackgroundDisabled}" />
    <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundDisabled}" />
  </Style>
  <Style Selector="Button.danger:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundDisabled}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrushDisabled}" />
  </Style>
  <!-- The mark of a message priority in the list; a high one stands out. -->
  <Style Selector="Border.priority">
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
  </Style>
  <Style Selector="Border.priority.high">
    <Setter Property="Background" Value="{DynamicResource Brush.WarningBg}" />
  </Style>

  <!-- A row of color circles to choose from, each item a #RRGGBB string; a ring marks the chosen one. -->
  <Style Selector="ListBox.swatches">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <WrapPanel />
      </ItemsPanelTemplate>
    </Setter>
    <Setter Property="ItemTemplate">
      <DataTemplate x:DataType="x:String">
        <Border Width="18" Height="18" CornerRadius="9" Background="{Binding}" />
      </DataTemplate>
    </Setter>
  </Style>
  <Style Selector="ListBox.swatches ListBoxItem" x:DataType="x:String">
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="ToolTip.Tip" Value="{Binding}" />
    <Setter Property="AutomationProperties.Name" Value="{Binding}" />
  </Style>
  <Style Selector="ListBox.swatches ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Padding" Value="2" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="CornerRadius" Value="13" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.swatches ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
  </Style>
  <Style Selector="ListBox.swatches ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.TextPrimary}" />
  </Style>
  <Style Selector="ListBox.swatches ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.TextPrimary}" />
  </Style>
</Styles>
